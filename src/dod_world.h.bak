#ifndef DODWORLD_H
#define DODWORLD_H

#include "util/util.h"
#include "render.h"
#include "logic.h"

#define WORLD_SIZE          1024
#define SEG_SIZE            32
#define SEG_PER_ROW         WORLD_SIZE / SEG_SIZE
#define SEG_TOTAL           SEG_PER_ROW * SEG_PER_ROW
#define LAYER_TILECOUNT     SEG_SIZE * SEG_SIZE
#define VIEW_DIST           4
#define TILE_WIREGAP        0.2f
#define WIRE_PERM_COUNT     16

enum layer_type {
    LAYER_RED,
    LAYER_GREEN,
    LAYER_BLUE,
    LAYER_TOTAL
};

enum tile_type {
    TILE_NONE,
    TILE_WIRE,
    TILE_PACK,
    TILE_PIN
};

enum tile_state {
    TILE_TOP     = BIT(0),
    TILE_BOT     = BIT(1),
    TILE_LEFT    = BIT(2),
    TILE_RIGHT   = BIT(3),
    TILE_CENTRE  = BIT(4),
    TILE_POWERED = BIT(5)
};

enum wire_type {
    WIRE_RED,
    WIRE_GREEN,
    WIRE_BLUE,
    WIRE_NONE,
    WIRE_TOTAL
};

enum mouse_mode {
    MOUSE_NONE,
    MOUSE_DRAW,
    MOUSE_ERASE,
    MOUSE_GRAB,
    MOUSE_DRAGBOX
};

typedef struct FreeSegments {
    struct {
        uint x, y;
    } pos[SEG_TOTAL];

    struct {
        uint w, h;
    } size [SEG_TOTAL];

    uint dirty[SEG_TOTAL];
    VBuffer vbo[SEG_TOTAL];
    VBuffer wirevbo[SEG_TOTAL];
    VecList colors[SEG_TOTAL];
    mat4 modelmat[SEG_TOTAL];
    uint tiles[SEG_TOTAL][LAYER_TOTAL][LAYER_TILECOUNT];
} FreeSegments;

typedef struct Segments {
    struct {
        uint x, y;
    } pos[SEG_TOTAL];
    uint dirty[SEG_TOTAL];
    VBuffer vbo[SEG_TOTAL];
    VBuffer wirevbo[SEG_TOTAL];
    VecList colors[SEG_TOTAL];
    mat4 modelmat[SEG_TOTAL];
    uint tiles[SEG_TOTAL][LAYER_TOTAL][LAYER_TILECOUNT];
} Segments;

typedef struct Worlds {
    Segments *segs;
} Worlds;

typedef struct SelectBox {
    float x, y, w, h;
    int enabled;
} SelectBox;

uint 

#endif /* WORLD_H */
